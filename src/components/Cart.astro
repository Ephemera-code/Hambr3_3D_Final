---
import { PHONE_DISPLAY } from "../data/config";
// src/components/Cart.astro
// Panel lateral del carrito. Se incluye UNA vez, en el Layout.
---

<!-- Aviso para lectores de pantalla -->
<span id="cart-live" class="sr-only" aria-live="polite"></span>

<button
  id="cart-toggle"
  type="button"
  aria-label="Abrir carrito"
  aria-haspopup="dialog"
  aria-controls="cart-drawer"
  aria-expanded="false"
  data-sfx="clack"
  class="fixed right-5 bottom-5 z-40 flex h-16 w-16 items-center justify-center rounded-full border-4 border-black bg-punk-orange text-black shadow-[4px_4px_0px_#fff] transition hover:scale-105 hover:bg-orange-600 active:translate-x-1 active:translate-y-1 sm:right-8 sm:bottom-8"
>
  <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
    <path d="M3 6h18M16 10a4 4 0 0 1-8 0" />
  </svg>
  <span id="cart-count" class="absolute -top-1 -right-1 flex h-6 min-w-6 items-center justify-center rounded-full border-2 border-black bg-punk-yellow px-1 font-mono text-xs font-bold text-black" hidden>0</span>
</button>

<!-- Fondo oscuro -->
<div
  id="cart-overlay"
  class="pointer-events-none fixed inset-0 z-50 bg-black/80 opacity-0 backdrop-blur-md transition-opacity duration-300"
></div>

<!-- Panel -->
<aside
  id="cart-drawer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cart-title"
  aria-hidden="true"
  class="invisible fixed inset-y-0 right-0 z-50 flex w-full max-w-md translate-x-full flex-col border-l-4 border-zinc-800 bg-zinc-950 p-6 shadow-2xl transition-[transform,visibility] duration-300"
>
  <header class="mb-4 flex items-center justify-between border-b-2 border-zinc-800 pb-4">
    <div class="flex items-center gap-3">
      <svg class="h-7 w-7 text-punk-orange" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
        <path d="M3 6h18M16 10a4 4 0 0 1-8 0" />
      </svg>
      <div>
        <h2 id="cart-title" class="font-anton text-3xl text-white">COMANDA HAMBRE</h2>
        <p class="font-mono text-xs text-zinc-400">WhatsApp Directo: {PHONE_DISPLAY}</p>
      </div>
    </div>
    <button
      id="cart-close"
      type="button"
      aria-label="Cerrar carrito"
      class="rounded p-1 text-2xl text-zinc-400 transition hover:text-white"
    >×</button>
  </header>

  <div class="flex-1 overflow-y-auto pr-1 font-mono text-xs">
    <p id="cart-empty" class="py-8 text-center text-zinc-600">
      COMANDA VACÍA
    </p>
    <ul id="cart-items" class="space-y-3"></ul>
  </div>

  <footer id="cart-footer" hidden class="mt-4 space-y-4 border-t-2 border-zinc-800 pt-4">
    <div class="flex items-end justify-between">
      <span class="font-anton text-2xl text-zinc-400">TOTAL:</span>
      <strong id="cart-total" class="font-anton text-4xl text-punk-yellow"></strong>
    </div>
    <a
      id="cart-checkout"
      href="#"
      target="_blank"
      rel="noopener"
      class="flex items-center justify-center gap-2 rounded border-2 border-black bg-emerald-600 py-3.5 text-center font-anton text-xl text-white shadow-[4px_4px_0px_#000] transition hover:bg-emerald-500"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="m22 2-7 20-4-9-9-4Z" />
        <path d="M22 2 11 13" />
      </svg>
      ENVIAR PEDIDO POR WHATSAPP
    </a>
    <button
      id="cart-clear"
      type="button"
      class="w-full font-mono text-xs text-zinc-500 underline underline-offset-4 transition hover:text-punk-orange"
    >
      Vaciar comanda
    </button>
  </footer>
</aside>

<script>
  import { addItem, clear, count, getItems, removeItem, setQty, total, CART_EVENT } from "../lib/cart";
  import { formatPrice } from "../lib/format";
  import { WHATSAPP_NUMBER } from "../data/config";

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const toggle = $<HTMLButtonElement>("cart-toggle");
  const badge = $("cart-count");
  const live = $("cart-live");
  const overlay = $("cart-overlay");
  const drawer = $("cart-drawer");
  const closeBtn = $<HTMLButtonElement>("cart-close");
  const list = $("cart-items");
  const empty = $("cart-empty");
  const footer = $("cart-footer");
  const totalEl = $("cart-total");
  const checkout = $<HTMLAnchorElement>("cart-checkout");
  const clearBtn = $<HTMLButtonElement>("cart-clear");

  const reduceMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

  // ── Dibujar el carrito ────────────────────────────────────────────────────
  function render() {
    const items = getItems();
    const n = count();

    badge.textContent = String(n);
    badge.hidden = n === 0;
    live.textContent = n === 0 ? "Carrito vacío" : `Carrito: ${n} ${n === 1 ? "producto" : "productos"}`;

    empty.hidden = items.length > 0;
    footer.hidden = items.length === 0;
    totalEl.textContent = formatPrice(total());

    list.innerHTML = items
      .map(
        (i) => `
      <li class="py-4">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="font-semibold text-[#efe9dc]">${esc(i.name)}</p>
            <p class="text-sm text-zinc-400">${formatPrice(i.price)} c/u</p>
          </div>
          <button type="button" data-action="remove" data-id="${esc(i.id)}" aria-label="Quitar ${esc(i.name)} del carrito"
            class="shrink-0 rounded-full px-2 text-xl text-zinc-500 transition hover:text-punk-orange">×</button>
        </div>
        <div class="mt-3 flex items-center justify-between">
          <div class="flex items-center gap-1 rounded-full bg-zinc-900">
            <button type="button" data-action="dec" data-id="${esc(i.id)}" aria-label="Restar uno a ${esc(i.name)}"
              class="h-9 w-9 rounded-full text-lg text-zinc-300 transition hover:bg-zinc-800">−</button>
            <span class="w-8 text-center font-semibold text-[#efe9dc]" aria-label="Cantidad">${i.qty}</span>
            <button type="button" data-action="inc" data-id="${esc(i.id)}" aria-label="Sumar uno a ${esc(i.name)}"
              class="h-9 w-9 rounded-full text-lg text-zinc-300 transition hover:bg-zinc-800">+</button>
          </div>
          <p class="font-bold text-[#efe9dc]">${formatPrice(i.price * i.qty)}</p>
        </div>
      </li>`
      )
      .join("");

    checkout.href = whatsappUrl();
  }

  function whatsappUrl() {
    const lines = getItems().map((i) => `• ${i.qty} x ${i.name} — ${formatPrice(i.price * i.qty)}`);
    const text = `¡Hola! Quiero hacer este pedido:\n\n${lines.join("\n")}\n\nTotal: ${formatPrice(total())}`;
    return `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(text.replace(/\u00a0/g, " "))}`;
  }

  // ── Abrir y cerrar ────────────────────────────────────────────────────────
  let isOpen = false;

  function open() {
    isOpen = true;
    drawer.classList.remove("invisible", "translate-x-full");
    drawer.classList.add("translate-x-0");
    drawer.setAttribute("aria-hidden", "false");
    overlay.classList.remove("pointer-events-none", "opacity-0");
    overlay.classList.add("opacity-100");
    document.documentElement.classList.add("overflow-hidden");
    toggle.setAttribute("aria-expanded", "true");
    closeBtn.focus();
  }

  function close() {
    isOpen = false;
    drawer.classList.add("invisible", "translate-x-full");
    drawer.classList.remove("translate-x-0");
    drawer.setAttribute("aria-hidden", "true");
    overlay.classList.add("pointer-events-none", "opacity-0");
    overlay.classList.remove("opacity-100");
    document.documentElement.classList.remove("overflow-hidden");
    toggle.setAttribute("aria-expanded", "false");
    toggle.focus();
  }

  toggle.addEventListener("click", () => (isOpen ? close() : open()));
  closeBtn.addEventListener("click", close);
  overlay.addEventListener("click", close);

  document.addEventListener("keydown", (e) => {
    if (!isOpen) return;
    if (e.key === "Escape") return close();
    if (e.key !== "Tab") return;
    // Mantener el foco dentro del panel
    const focusables = drawer.querySelectorAll<HTMLElement>("button:not([hidden]), a[href]");
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // ── Acciones dentro del panel ─────────────────────────────────────────────
  list.addEventListener("click", (e) => {
    const btn = (e.target as Element).closest<HTMLElement>("[data-action]");
    if (!btn) return;
    const id = btn.dataset.id!;
    const item = getItems().find((i) => i.id === id);
    if (!item) return;
    if (btn.dataset.action === "inc") setQty(id, item.qty + 1);
    if (btn.dataset.action === "dec") setQty(id, item.qty - 1);
    if (btn.dataset.action === "remove") removeItem(id);
  });

  clearBtn.addEventListener("click", clear);

  // ── Botones "Agregar al carrito" (en cualquier página) ────────────────────
  document.addEventListener("click", (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>("[data-add]");
    if (!btn) return;

    addItem({
      id: btn.dataset.id!,
      name: btn.dataset.name!,
      price: Number(btn.dataset.price),
    });

    const label = btn.querySelector<HTMLElement>("[data-label]");
    if (label && !btn.dataset.busy) {
      const original = label.textContent;
      btn.dataset.busy = "1";
      label.textContent = "Agregado ✓";
      setTimeout(() => {
        label.textContent = original;
        delete btn.dataset.busy;
      }, 1200);
    }

    if (!reduceMotion()) {
      toggle.animate(
        [{ transform: "scale(1)" }, { transform: "scale(1.2)" }, { transform: "scale(1)" }],
        { duration: 300 }
      );
    }
  });

  window.addEventListener(CART_EVENT, render);
  render();
</script>