---
import { Image } from "astro:assets";
import { categories } from "../data/categories";
import { products } from "../data/products";
import { formatPrice } from "../lib/format";
import { categoryPhoto, productPhoto } from "../lib/photos";

const categoryNames = new Map(categories.map(({ slug, name }) => [slug, name]));
---

<section id="productos" class="relative scroll-mt-24 px-4 py-20 md:px-8">
  <div id="fanzine-menu" class="mx-auto max-w-7xl">
    <div class="mb-16 space-y-4 text-center">
      <div class="tape-caution inline-block -rotate-2 px-6 py-2 text-2xl">
        HOJA #02 • MENU
      </div>
      <h2 class="font-anton text-4xl uppercase tracking-wide text-white sm:text-6xl md:text-8xl">
        CARTA
        <span class="inline-block bg-linear-to-r from-punk-orange via-punk-yellow to-white bg-clip-text text-transparent">
          &nbsp;PIZZAS, PANUZZO & MÁS
        </span>
      </h2>
      <p class="mx-auto max-w-lg font-mono text-xs text-zinc-400 sm:text-sm">
        Sacate el hambre con nuestras pizzas, panuzzo, milanesas y papas. 
      </p>
    </div>

    <div class="mb-12 flex flex-wrap items-center justify-center gap-3">
      <button
        type="button"
        data-filter="all"
        aria-pressed="true"
        data-sfx="click"
        class="fanzine-tab active rounded-lg border-2 border-black bg-punk-orange px-6 py-2 font-anton text-2xl text-black shadow-[4px_4px_0px_#fff]"
      >
        TODOS
      </button>
      {
        categories.map((category) => (
          <button
            type="button"
            data-filter={category.slug}
            aria-pressed="false"
            data-sfx="click"
            class="fanzine-tab rounded-lg border-2 border-zinc-800 bg-zinc-900 px-6 py-2 font-anton text-xl text-white transition hover:bg-zinc-800 sm:text-2xl"
          >
            {category.name.toUpperCase()}
          </button>
        ))
      }
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-3" id="menuGrid">
      {
        products.map((product, index) => {
          const photo =
            productPhoto(product.category, product.slug) ?? categoryPhoto(product.category);
          const categoryName = categoryNames.get(product.category) ?? product.category;
          const rotation = index % 2 === 0 ? "-2deg" : "2deg";

          return (
            <article
              data-product-card
              data-category={product.category}
              class="polaroid-frame tilt-card relative rounded-2xl border-4 border-black p-5 shadow-xl"
              style={`--card-rotation:${rotation};transform:rotate(${rotation})`}
            >
              <div class="tape-caution absolute -top-3 left-6 z-10 px-3 py-0.5 font-anton text-xs uppercase">
                {categoryName}
              </div>
              <div class="tape-duct pointer-events-none absolute -top-3 right-6 z-10 h-5 w-16 rotate-6"></div>

              <div class="relative mb-4 aspect-video overflow-hidden rounded-xl border-2 border-black bg-black">
                {
                  photo ? (
                    <Image
                      src={photo}
                      alt={product.name}
                      widths={[400, 800, 1200]}
                      sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                      format="webp"
                      quality={75}
                      class="h-full w-full object-cover"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-linear-to-br from-neutral-800 to-neutral-950 font-anton text-5xl text-punk-orange">
                      {categoryName.toUpperCase()}
                    </div>
                  )
                }
                <span class="absolute right-2 bottom-2 border border-white bg-black px-2 py-0.5 font-anton text-2xl text-punk-yellow">
                  {formatPrice(product.price)}
                </span>
              </div>

              <h3 class="mb-2 font-anton text-3xl leading-tight text-black">{product.name}</h3>
              <p class="mb-4 font-sans text-xs leading-relaxed text-zinc-800">{product.description}</p>
              <button
                type="button"
                data-add
                data-sfx="clack"
                data-id={`${product.category}/${product.slug}`}
                data-name={product.name}
                data-price={product.price}
                class="w-full rounded-lg border-2 border-black bg-black py-2.5 font-anton text-xl text-punk-yellow shadow-[3px_3px_0px_#ff3a00] transition hover:bg-punk-orange hover:text-black"
              >
                <span data-label>+ AGREGAR AL PEDIDO</span>
              </button>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
